# Claude / AI tool local files
.claude/*
# ただし共有スキル（session-end 等）はリポジトリにコミットして残す。
# クラウド実行の Claude Code は個人スキル ~/.claude/skills/ を保持しないため。
!.claude/skills/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs / temporary files
*.log
*.tmp
*.bak
*.swp
~$*

# Environment / secrets
.env
.env.*

# Future build/dependency folders
node_modules/
dist/
build/
.cache/
coverage/

# =========================================================================
# センシティブ / R-18 アセット — 絶対にコミットしない
# 理由: git履歴は後から消せない（push後は特に取り返しがつかない）。
# 実CG・実素材はローカル / Unity側 / DLsite配信でのみ管理する。
# gitが持つのは asset-resolver.js が参照する「ID・テキスト構造」だけにする。
# =========================================================================

# adult / r18 アセット置き場（ディレクトリごと除外）
assets/adult/
assets/r18/
adult/
r18/
cg/adult/
cg/r18/

# {scene_id}_adult.* 命名のCG・素材（差し替えアーキテクチャの命名規約に対応）
**/*_adult.png
**/*_adult.jpg
**/*_adult.jpeg
**/*_adult.webp
**/*_adult.gif
**/*_adult.psd
**/*_adult.clip

# 制作元データ（作業用ファイル。誤コミット防止）
*.psd
*.clip
*.xcf
*.sai
*.ai
*.kra

# 実R-18本文を入れる段階で使う adult 編集元CSV・その生成物（ローカル限定）
# 全年齢の night-care.csv は追跡するが、adult 本文は git に載せない
night-care.adult.csv
*.adult.csv
night-care-data.adult.js